[Unit]
Description=EasyWAF — self-contained Web Application Firewall and reverse proxy
After=network.target

[Service]
Type=simple
# Templates, static assets and the rule-signing key are compiled into the
# binary. EasyWAF reads config.toml relative to its working directory, creates
# easywaf.db there on first run, and mirrors the rule channel to rules-cache/
# beside it. rules/ holds only the offline seed for that mirror.
WorkingDirectory=/opt/easywaf
ExecStart=/usr/bin/easywaf
Restart=on-failure
RestartSec=3

# An account of its own, not root. EasyWAF reads hostile traffic all day, and
# the one thing it needs beyond an ordinary user is to bind ports below 1024.
# The package creates the account and hands it /opt/easywaf
# (packaging/service-account.sh, run after every install and upgrade).
User=easywaf
Group=easywaf
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Every connection holds a file descriptor, and so does every backend
# connection behind it. The default soft limit of 1024 is a ceiling a busy
# site, or a flood of connections, reaches quickly.
LimitNOFILE=65536

# Creates /var/log/easywaf, where the audit log is written, owned by the
# account above. systemd makes it before the service starts, so EasyWAF never
# has to create a directory under /var/log itself.
LogsDirectory=easywaf

# What it has no business touching. /usr, /boot and /etc are read-only to it,
# home directories are out of reach, and it gets a /tmp of its own. Its data
# stays writable: /opt/easywaf and the log directory. A database kept somewhere
# else needs that place to be writable by the easywaf account.
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
