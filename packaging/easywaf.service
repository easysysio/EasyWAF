[Unit]
Description=EasyWAF — self-contained Web Application Firewall and reverse proxy
After=network.target

[Service]
Type=simple
# Templates, static assets and the rule-signing key are compiled into the
# binary. EasyWAF reads config.toml relative to its working directory, creates
# easywaf.db there on first run, and mirrors the rule channel to rules-cache/
# beside it. rules/ holds only the offline seed for that mirror.
WorkingDirectory=/opt/easywaf
ExecStart=/usr/bin/easywaf
Restart=on-failure
RestartSec=3
# Allow binding privileged ports (e.g. a site on port 80) without full root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Creates and owns /var/log/easywaf, where the audit log is written. systemd
# makes it before the service starts, so EasyWAF never has to create a
# directory under /var/log itself.
LogsDirectory=easywaf

[Install]
WantedBy=multi-user.target
