#!/bin/sh
# =========================================================
# postinst — EasyWAF (Debian/Ubuntu)
# Runs after the package is unpacked and configured, on a
# first install and on every upgrade.
#
# Everything it does is in /usr/lib/easywaf/service-account,
# which the RPM runs too: the account the service runs as,
# its files, and bringing a running service onto the new
# binary.
#
# Without that last part, an upgrade replaces /usr/bin/easywaf
# and the unit file on disk but leaves the running service on
# the old binary, so the GUI keeps reporting the previous
# version until someone notices.
# =========================================================
set -e

case "$1" in
    configure)
        /usr/lib/easywaf/service-account
        ;;
esac

exit 0
